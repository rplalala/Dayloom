# Copy this file to .env for local development.
# Provider settings can also be entered at /config through uv run dayloom start.

# Model deployment and database connection defaults are configured in product.example.yaml; customize in ignored product.yaml.
# Private Microsoft Foundry credential
AZURE_OPENAI_API_KEY=

# V1-A Google Maps Platform configuration
GOOGLE_MAPS_API_KEY=

# Shared Dayloom database and TripWorld query embeddings
OPENAI_API_KEY=
DAYLOOM_DB_PASSWORD=

UNSPLASH_API_KEY=
# Shared database storage; existing installs select their retained volume.
DAYLOOM_DB_VOLUME=dayloom_pgdata

# Local startup retains an existing key or generates and saves one automatically.
# Optional: provide your own key of at least 32 characters, or use /config.
PRODUCT_JWT_SECRET=
