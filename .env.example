# Copy this file to .env for local development.
# Provider settings can also be entered at /config through scripts/run_product.py.

# Model deployment and database connection defaults are configured in product.yaml.
# Private Microsoft Foundry credential
AZURE_OPENAI_API_KEY=

# V1-A Google Maps Platform configuration
GOOGLE_MAPS_API_KEY=

# Shared Dayloom database and TripWorld query embeddings
OPENAI_API_KEY=
DAYLOOM_DB_PASSWORD=

UNSPLASH_API_KEY=
# Shared database storage; existing installs select their retained volume.
DAYLOOM_DB_VOLUME=dayloom_pgdata

# Generate a private signing secret with at least 32 characters.
PRODUCT_JWT_SECRET=
