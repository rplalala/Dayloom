# Copy this file to .env for local development.

# Shared model and Microsoft Foundry configuration
AZURE_OPENAI_ENDPOINT=
# Use the deployment name configured on your Microsoft Foundry endpoint.
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_KEY=

# V1-A Google Maps Platform configuration
GOOGLE_MAPS_API_KEY=

# Shared Dayloom database and TripWorld query embeddings
OPENAI_API_KEY=
DAYLOOM_DB_HOST=127.0.0.1
DAYLOOM_DB_PORT=55432
DAYLOOM_DB_NAME=dayloom
DAYLOOM_DB_USER=dayloom
DAYLOOM_DB_PASSWORD=

# Shared database storage; existing installs select their retained volume.
DAYLOOM_DB_VOLUME=dayloom_pgdata

# Generate a private signing secret with at least 32 characters.
PRODUCT_JWT_SECRET=
