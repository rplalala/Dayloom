# Public release defaults. The launcher creates config/.env with private instance values.
# Release packaging replaces these local references with the selected immutable images.
DAYLOOM_APP_IMAGE=dayloom-app:local
DAYLOOM_BASELINE_IMAGE=dayloom-baseline:local
DAYLOOM_BASELINE_ID=UNRELEASED
DAYLOOM_HOST_PORT=5173
COMPOSE_PROJECT_NAME=dayloom-deploy
DAYLOOM_DB_NAME=dayloom
DAYLOOM_DB_USER=dayloom
